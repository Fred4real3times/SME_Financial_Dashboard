# Copy to .env for local overrides. Do not commit real credentials or secrets.
# SQLite file is created under .data/ by default.
DATABASE_URL=sqlite:///./.data/sme_financial_dashboard.db
APP_ENV=development
APP_LOG_LEVEL=INFO
SESSION_SECRET=replace-with-a-local-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12
